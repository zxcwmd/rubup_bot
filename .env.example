# Telegram: token from @BotFather and numeric IDs of administrators.
TELEGRAM_BOT_TOKEN=123456789:replace_me
ADMIN_USER_IDS=123456789

# One TikTok account. The username is needed to avoid replying to yourself.
TIKTOK_USERNAME=your_tiktok_username
HEADLESS=false
BROWSER_SLOW_MO_MS=80
NAVIGATION_TIMEOUT_MS=45000

# Automation starts only after the ▶️ Авто button in Telegram.
AUTO_START=false
SCAN_INTERVAL_MINUTES=45
MAX_TAGS_PER_CYCLE=4
DISCOVERY_LIMIT_PER_TAG=8
MAX_VIDEO_DETAILS_PER_CYCLE=20
MAX_ACTIONS_PER_CYCLE=4
MAX_COMMENTS_PER_DAY=10
MAX_REPLIES_PER_DAY=20
MAX_REPLIES_PER_VIDEO=2
ACTION_DELAY_SECONDS=20
ACTION_JITTER_SECONDS=15

# Only videos published on/after this date are eligible.
MIN_VIDEO_DATE=2026-05-01

# Text safeguards. Disclosure is appended to every paid publication.
AD_DISCLOSURE=Реклама
SIMILARITY_THRESHOLD=0.86
TARGET_SIMILARITY_THRESHOLD=0.92
ALLOW_GIFT_CLAIMS=false

# Conservative detection of other RubUP comments. Add exact known markers,
# separated by |, only after checking real examples. Own comments are excluded.
RUBUP_COMMENT_MARKERS=rubup|rub\s*up

# Local folders. Relative paths are resolved from the project directory.
DATA_DIR=data
IMAGE_DIR=images
TEMPLATE_DIR=templates
SELECTORS_PATH=selectors.json
BROWSER_PROFILE_DIR=data/browser-profile

# Optional diagnostics.
LOG_LEVEL=INFO
